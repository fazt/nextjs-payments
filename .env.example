# Copia este archivo a .env y completa los valores. No subas .env al repositorio.
# Las pasarelas sin credenciales se muestran como "no disponibles" (la app arranca igual).

# --- Base de datos (docker compose up -d) ---
DATABASE_URL=postgresql://fazt:faztpassword@localhost:5463/nextfulldb

# --- Auth (next-auth) ---
# URL pública de la app; también se usa para las URLs de retorno de las pasarelas
NEXTAUTH_URL=http://localhost:3000
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Cloudinary (subida de imágenes de productos, opcional) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Stripe (modo test: claves sk_test_...) ---
STRIPE_SECRET_KEY=
# Secreto de firma del webhook (whsec_...). En local lo imprime `stripe listen`
STRIPE_ENDPOINT_SECRET=

# --- PayPal (sandbox) ---
# Sandbox: https://api-m.sandbox.paypal.com · Producción: https://api-m.paypal.com
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id del webhook creado en developer.paypal.com (necesario para verificar sus firmas)
PAYPAL_WEBHOOK_ID=

# --- Mercado Pago (credenciales de prueba) ---
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de la sección Webhooks de tu aplicación (valida la cabecera x-signature)
MERCADOPAGO_WEBHOOK_SECRET_KEY=
# URL pública https (túnel en desarrollo) para back_urls, auto_return y el webhook
MERCADOPAGO_BACKEND_URL=
# Opcional: public key para mostrar el Wallet Brick (si no, se redirige a Checkout Pro)
MERCADOPAGO_PUBLIC_KEY=
# Opcional: moneda de las preferencias (PEN por defecto)
MERCADOPAGO_CURRENCY=PEN
